<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#04120b"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🕌" android:textSize="64sp" />

    <TextView
        android:id="@+id/tvAzanPrayer"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Fajr" android:textColor="#d4af37" android:textSize="40sp"
        android:textStyle="bold" android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvAzanMsg"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="It is time for prayer." android:textColor="#ffffff"
        android:textSize="17sp" android:gravity="center" android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnAzanStop"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Stop azan" android:textSize="15sp" android:layout_marginTop="28dp" />
</LinearLayout>
